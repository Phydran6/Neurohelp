default_platform(:android)

AAB_PATH = "../build/app/outputs/bundle/release/app-release.aab"

# Die Store-Texte liegen unter fastlane/metadata/android/ und sind
# eingecheckt - wie bei iOS. So ist nachvollziehbar, was im Store steht, und
# eine Aenderung geht durch Review wie Code.
#
# Hochgeladen werden sie aber nur dort, wo es gewollt ist: Ein Lauf in den
# Track "internal" soll den oeffentlichen Eintrag nicht anfassen.
def metadata_off
  {
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true,
  }
end

# Track-Namen der Play Developer API – nicht die Namen aus der Console:
#   internal   = Interner Test
#   alpha      = Geschlossener Test (Standard-Track der Console)
#   beta       = OFFENER Test – fuer neue private Konten erst nach
#                Produktionszugriff verfuegbar
#   production = Produktion
#
# Ziel-Track und Status kommen aus der CI (Repository-Variablen
# PLAY_TRACK / PLAY_RELEASE_STATUS, siehe deploy.yml).
#
# Status "completed" = sofort an die Tester ausgerollt.
# Status "draft"     = liegt nur als Entwurf in der Console. Pflicht, solange
#                      die App noch "Entwurf" ist (vor dem allerersten
#                      Rollout) – sonst lehnt die API mit "Only releases with
#                      status draft may be created on draft app" ab.

platform :android do
  desc "AAB in den Play-Track hochladen (Standard: internal, completed)"
  lane :upload do
    upload_to_play_store(
      track: ENV.fetch("PLAY_TRACK", "internal"),
      aab: AAB_PATH,
      **metadata_off,
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
    )
  end

  # Alter Name, damit bestehende Aufrufe weiter funktionieren.
  lane :internal do
    upload
  end

  desc "Von 'internal' in den geschlossenen Test (alpha) hochstufen"
  lane :promote_closed do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "alpha",
      skip_upload_aab: true,
      **metadata_off,
    )
  end

  desc "Vom geschlossenen Test (alpha) in die Produktion hochstufen"
  #
  # Der letzte Schritt vor der Oeffentlichkeit. `rollout` ist Absicht: Google
  # liefert die Version zunaechst nur an einen Teil der Geraete aus. Faellt
  # etwas auf, laesst sich das in der Console anhalten, bevor es alle trifft.
  # Den Anteil hochzudrehen ist ein Klick - ein Rueckruf ist es nicht.
  lane :promote_production do |options|
    rollout = (options[:rollout] || "0.2").to_s

    upload_to_play_store(
      track: "alpha",
      track_promote_to: "production",
      rollout: rollout,
      skip_upload_aab: true,
      **metadata_off,
    )
  end

  desc "Nur die Store-Texte und Bilder aktualisieren (ohne Build)"
  #
  # Das Gegenstueck zu `metadata_only` auf der iOS-Seite. Laeuft gegen den
  # vorhandenen Eintrag und laedt kein Paket hoch.
  lane :metadata_only do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Pruefen, ob der Play-Zugang funktioniert"
  #
  # Vor dem ersten echten Lauf: Ein falsch hinterlegter Service-Account faellt
  # sonst erst nach 20 Minuten Bauzeit auf, und die Meldung spricht dann von
  # einem fehlenden Paket statt von fehlenden Rechten.
  lane :check_access do
    validate_play_store_json_key
    UI.success("Play-Zugang steht.")
  end
end
