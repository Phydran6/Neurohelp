default_platform(:ios)

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV["APPSTORE_API_KEY_ID"],
    issuer_id: ENV["APPSTORE_API_ISSUER_ID"],
    key_content: ENV["APPSTORE_API_PRIVATE_KEY"],
    is_key_content_base64: true,
    in_house: false,
  )
end

# Version pruefen, bevor gebaut wird. Apple erlaubt in
# CFBundleShortVersionString nur Ziffern und hoechstens drei Punkte – ein
# `0.1.0-alpha.4` bricht erst beim Upload ab, nach 20 Minuten Bauzeit. Lieber
# gleich hier.
def checked_version(options)
  version = options[:version].to_s
  UI.user_error!("Parameter version: fehlt.") if version.empty?

  unless version.match?(/\A\d+(\.\d+){0,2}\z/)
    UI.user_error!(
      "Version \"#{version}\" ist fuer Apple ungueltig. Erlaubt sind nur " \
      "Ziffern und hoechstens drei durch Punkte getrennte Teile, z.B. 0.1.0. " \
      "Vorabzusaetze wie -alpha.4 muss die CI abschneiden.",
    )
  end

  version
end

def checked_build_number(options)
  number = options[:build_number].to_s
  UI.user_error!("Parameter build_number: fehlt.") if number.empty?
  number
end

APP_IDENTIFIER = "will.neurohelp.help".freeze
TEAM_ID = "352N56D836".freeze
PROFILE_NAME = "match AppStore #{APP_IDENTIFIER}".freeze

# Xcode auf manuelle Signatur umstellen, mit dem Profil von match.
#
# `flutter create` legt das Projekt mit automatischer Signatur an. Die sucht
# ein ENTWICKLER-Zertifikat - wir haben aber ein Verteilungs-Zertifikat fuer
# den App Store. Xcode ignoriert deshalb das match-Profil und bricht ab mit
# "No development certificates available to code sign app for device
# deployment". Das klingt nach einem fehlenden Zertifikat, ist aber die
# falsche Signatur-Art.
#
# Bewusst zur Laufzeit statt eingecheckt: `scripts/ensure_platforms.sh` kann
# das Projekt neu erzeugen, und dann waere die Einstellung wieder weg.
def use_manual_signing
  update_code_signing_settings(
    path: File.expand_path("../Runner.xcodeproj", __dir__),
    use_automatic_signing: false,
    team_id: TEAM_ID,
    bundle_identifier: APP_IDENTIFIER,
    code_sign_identity: "Apple Distribution",
    profile_name: PROFILE_NAME,
    targets: ["Runner"],
  )
end

platform :ios do
  before_all do
    # Pflicht auf einem CI-Rechner. `match` legt das Zertifikat in einen
    # Schluesselbund, und der Anmelde-Schluesselbund eines Runners ist gesperrt
    # bzw. gehoert keiner angemeldeten Sitzung. `setup_ci` erzeugt stattdessen
    # einen temporaeren, entsperrten Schluesselbund.
    #
    # Ohne das scheitert der Build an der Schluesselbund-Sperre, und die
    # Meldung spricht von einem Passwort - das liest sich wie ein falsches
    # MATCH_PASSWORD und ist etwas anderes.
    setup_ci if ENV["CI"]
  end

  # Einmalig, bevor der erste Build laufen kann: Zertifikat und Profil bei
  # Apple erzeugen und verschluesselt ins match-Repository legen. Alle
  # spaeteren Laeufe holen sie nur noch ab (`readonly: true`).
  #
  # Laeuft ueber .github/workflows/ios-signing.yml – ein Mac ist dafuer nicht
  # noetig, der GitHub-Runner ist einer.
  desc "Signatur einmalig einrichten (erzeugt Zertifikat und Profil)"
  lane :setup_signing do
    match(
      type: "appstore",
      readonly: false,
      api_key: app_store_api_key,
      git_url: ENV["MATCH_GIT_URL"],
    )
  end

  desc "Signiertes Release-IPA bauen"
  lane :build_release do |options|
    version = checked_version(options)
    build_number = checked_build_number(options)
    api_key = app_store_api_key

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
    )

    use_manual_signing

    sh(
      "cd .. && cd .. && flutter build ipa --release " \
      "--build-name=#{version} " \
      "--build-number=#{build_number} " \
      "--dart-define=FLAVOR=prod " \
      "--export-options-plist=ios/ExportOptions.plist",
    )
  end

  desc "Build bauen und an TestFlight schicken"
  lane :beta do |options|
    version = checked_version(options)
    build_number = checked_build_number(options)
    api_key = app_store_api_key

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
    )

    use_manual_signing

    # Die Version muss hier stehen. Ohne sie nimmt der Build den Wert aus der
    # pubspec.yaml, und `0.1.0-alpha.4` ist fuer Apple ungueltig (ITMS-90060).
    sh(
      "cd .. && cd .. && flutter build ipa --release " \
      "--build-name=#{version} " \
      "--build-number=#{build_number} " \
      "--dart-define=FLAVOR=prod " \
      "--export-options-plist=ios/ExportOptions.plist",
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/neurohelp.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Siehe CHANGELOG.md im Repository.",
    )
  end

  desc "Nur die Store-Texte und Bilder aktualisieren (ohne Build)"
  lane :metadata_only do
    deliver(
      api_key: app_store_api_key,
      skip_binary_upload: true,
      skip_app_version_update: true,
      submit_for_review: false,
    )
  end

  desc "Build hochladen und zur Prüfung einreichen"
  lane :release_store do |options|
    version = checked_version(options)
    build_number = checked_build_number(options)
    api_key = app_store_api_key

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
    )

    use_manual_signing

    sh(
      "cd .. && cd .. && flutter build ipa --release " \
      "--build-name=#{version} " \
      "--build-number=#{build_number} " \
      "--dart-define=FLAVOR=prod " \
      "--export-options-plist=ios/ExportOptions.plist",
    )

    deliver(
      api_key: api_key,
      ipa: "../build/ios/ipa/neurohelp.ipa",
      app_version: version,
      submit_for_review: true,
      # Ohne Verschlüsselung ausserhalb des Standards – der Eintrag steht
      # auch in der Info.plist, hier nur zur Sicherheit.
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
        add_id_info_uses_idfa: false,
      },
    )
  end
end
